# Git stores every text file with LF. Without this, a commit made from a
# Windows checkout can bake CRLF into the blob, and every other clone --
# including the Termux deploy target -- gets CRLF back out.
* text=auto

# Files a POSIX shell executes must keep LF in the working tree as well, not
# just in the blob. A CRLF shebang makes the kernel look for an interpreter
# literally named "/bin/bash\r", which fails as:
#     bad interpreter: No such file or directory
*.sh    text eol=lf
*.bash  text eol=lf

# deploy.sh parses DB_PATH out of .env with sed; a trailing CR would ride
# along into the path it then operates on.
.env.example text eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never apply end-of-line conversion to these.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.mp4    binary
*.woff   binary
*.woff2  binary
*.so     binary
*.tar.gz binary
*.db     binary
*.joblib binary
