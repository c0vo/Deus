# ==============================================================================
# Deus — Environment Configuration
# Copy this file to .env and fill in your values.
# All keys are optional unless marked [REQUIRED].
# ==============================================================================

# === LLM [REQUIRED for classification/ranking] ===
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_MODEL_CLASSIFIER=gemini-3.1-flash-lite
DEEPSEEK_MODEL_CLASSIFIER=deepseek-v4-flash
DEEPSEEK_MODEL_REDDIT_SENTIMENT=deepseek-v4-flash
GEMINI_MODEL_RANKER=gemini-3.1-flash-lite
GEMINI_MODEL_CHAT=gemini-3-flash-preview
DEEPSEEK_MODEL_REASONER=deepseek-v4-pro

# === Telegram Bot [REQUIRED for bot interface] ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === News APIs (optional — system works without these, using RSS only) ===
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# === Web Search (optional — enables real-time news for agent debates) ===
TAVILY_API_KEY=
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_MAX_RESULTS=5

# === Nitter / X-Twitter Scraping ===
# Comma-separated list of Nitter mirror instances (tried in order, failover)
NITTER_INSTANCES=nitter.net,nitter.privacydev.net,nitter.poast.org
# Comma-separated list of X/Twitter handles to follow (no @ prefix)
NITTER_ACCOUNTS=DeItaone,realDonaldTrump

# === Reddit ===
# Comma-separated list of subreddits to monitor
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,smallstreetbets

# === SEC EDGAR (insider trades, 13D/G stakes) ===
# No API key exists for EDGAR, but it returns 403 unless the User-Agent carries
# a contact address. Format: "Name email@example.com". Leave empty to disable
# the insider/institutional jobs.
SEC_USER_AGENT=
# How far back the initial insider backfill reaches (days).
INSIDER_BACKFILL_DAYS=1095

# === RSS Feeds ===
# Optional. Leave unset to use the built-in list (see DEFAULT_RSS_FEEDS in
# config/settings.py). Must be a JSON array — feed URLs contain query strings,
# so a plain comma-separated value would split mid-URL.
# Each entry is "name|url" or "name|url|max_items" (max_items defaults to 30).
# RSS_FEEDS=["wsj_markets|https://feeds.content.dowjones.io/public/rss/RSSMarketsMain","korea_times_economy|https://feed.koreatimes.co.kr/k/economy.xml|25"]

# === Schedule (times in KST = UTC+9) ===
FETCH_INTERVAL_HOURS=2
BRIEFING_HOUR=5
BRIEFING_MINUTE=0
DIGEST_DAY=sun
DIGEST_HOUR=20

# === System ===
LOG_LEVEL=INFO
DB_PATH=storage/deus.db
TIMEZONE=Asia/Seoul
ANDROID_API_LEVEL=24
SQLITE_VEC_PATH=
