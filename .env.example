# ==============================================================================
# Deus — Environment Configuration
# Copy this file to .env and fill in your values.
# All keys are optional unless marked [REQUIRED].
# ==============================================================================

# === LLM [REQUIRED] ===
#
# One key. Every model call — classification, ranking, chat, debate, thesis and
# embeddings — goes through OpenRouter over its OpenAI-compatible API.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
#
# Each setting below picks the model for ONE function, and the value is a full
# OpenRouter slug. The provider is just the prefix, so moving a function from
# Google to DeepSeek (or anywhere else) is a one-line edit here and a restart —
# no code change. Browse and compare live prices at:
#   https://openrouter.ai/models
# Three ranked picks per setting, with prices, verification notes and
# copy-paste presets: docs/model-routing.md
#
# An empty value disables that function; the app names every unset one at
# startup rather than failing later on the first call.
#
# Per-request ceiling in seconds. The debate and thesis calls run at xhigh
# reasoning effort and legitimately take minutes.
LLM_TIMEOUT_SECONDS=240

# -- Ingest lane. Highest volume by far, so this is where model price matters
#    most. The _FALLBACK pair is tried only if the primary errors.
MODEL_CLASSIFIER=
MODEL_CLASSIFIER_FALLBACK=
MODEL_REDDIT_SENTIMENT=
MODEL_REDDIT_SENTIMENT_FALLBACK=
# Nothing reaches the daily brief or the alerts without this one.
MODEL_RANKER=
# IPO details, calendar events, web-search summaries.
MODEL_EXTRACT=

# -- Chat lane. User-facing, so latency matters as much as unit cost.
MODEL_ROUTER=
MODEL_CHAT_SHALLOW=
MODEL_CHAT_COMPLEX=

# -- Batch note-writing. Short context, structured JSON out.
MODEL_TRENDING=
MODEL_DAILY_ADVISOR=
MODEL_MARKET_SCANNER=
MODEL_SECTOR_ANALYZER=
MODEL_TREND_OUTLOOK=
MODEL_PREDICTOR_NARRATIVE=
MODEL_REFLECTION=

# -- Reasoning lane. Lowest volume, highest cost per call. The debate is
#    separate from the reasoner so the two can be dialled independently.
MODEL_DEBATE=
MODEL_TRADER=
MODEL_REASONER=
MODEL_THESIS_REASONER=
MODEL_THESIS_EXTRACT=

# -- Embeddings. PINNED, and the one model that is not free to change: stored
#    vectors are 3072-dim and are compared directly against new ones, so any
#    other model silently breaks dedup, RAG and thesis grounding. The embedder
#    rejects off-width vectors rather than storing them.
MODEL_EMBEDDING=google/gemini-embedding-001

# === Telegram Bot [REQUIRED for bot interface] ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === News APIs (optional — system works without these, using RSS only) ===
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

# === Web Search (optional — enables real-time news for agent debates) ===
TAVILY_API_KEY=
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_MAX_RESULTS=5

# === Nitter / X-Twitter Scraping ===
# Comma-separated list of Nitter mirror instances (tried in order, failover)
NITTER_INSTANCES=nitter.net,nitter.privacydev.net,nitter.poast.org
# Comma-separated list of X/Twitter handles to follow (no @ prefix)
NITTER_ACCOUNTS=DeItaone,realDonaldTrump

# === Reddit ===
# Comma-separated list of subreddits to monitor
REDDIT_SUBREDDITS=wallstreetbets,stocks,investing,smallstreetbets

# === SEC EDGAR (insider trades, 13D/G stakes) ===
# No API key exists for EDGAR, but it returns 403 unless the User-Agent carries
# a contact address. Format: "Name email@example.com". Leave empty to disable
# the insider/institutional jobs.
SEC_USER_AGENT=
# How far back the initial insider backfill reaches (days).
INSIDER_BACKFILL_DAYS=1095

# === Off-exchange (dark pool) volume — FINRA ===
# No API key: the daily file is a public CDN object covering every US symbol.
# This is the cold-start window for the scheduled job only. A full history
# backfill is a separate one-shot run of scripts/manual/backfill_darkpool.py,
# which takes 30-60 minutes and should not happen during startup.
DARKPOOL_BACKFILL_DAYS=30

# === Option-chain snapshots ===
# yfinance has no options history, so this panel only builds forward at one
# session per day. Disabling it saves a small daily burst of yfinance calls but
# forfeits calendar time that cannot be backfilled later.
OPTIONS_SNAPSHOT_ENABLED=true

# === RSS Feeds ===
# Optional. Leave unset to use the built-in list (see DEFAULT_RSS_FEEDS in
# config/settings.py). Must be a JSON array — feed URLs contain query strings,
# so a plain comma-separated value would split mid-URL.
# Each entry is "name|url" or "name|url|max_items" (max_items defaults to 30).
# RSS_FEEDS=["wsj_markets|https://feeds.content.dowjones.io/public/rss/RSSMarketsMain","korea_times_economy|https://feed.koreatimes.co.kr/k/economy.xml|25"]

# === Schedule (times in KST = UTC+9) ===
FETCH_INTERVAL_HOURS=2
BRIEFING_HOUR=5
BRIEFING_MINUTE=0

# === Processes ===
# The pipeline and Telegram bot run in worker.py, separate from the API in
# main.py, so a long ingest cycle can never stall the dashboard. Run both:
#   python worker.py &   # pipeline + Telegram bot
#   python main.py       # API + dashboard on :8000
# Set this to true to fold them back into main.py as a single process. Local
# development only — it reintroduces the event-loop contention the split fixed.
ENABLE_IN_PROCESS_WORKER=false

# How long the worker waits before its first full pipeline cycle. A cycle fired
# at t=0 competes with the dashboard's first page load.
PIPELINE_STARTUP_DELAY_SECONDS=90

# Delay before the catch-up pass for missed daily jobs. Longer than the above:
# it can trigger multi-agent debates and a price call per unresolved prediction.
STARTUP_CATCHUP_DELAY_SECONDS=300

# How often the worker refreshes latest_prices, which /api/markets reads. The
# endpoint never calls Yahoo itself.
PRICE_REFRESH_SECONDS=60

# === System ===
LOG_LEVEL=INFO

# Store the full prompt and response of every classify/rank call in
# llm_usage_log. Off by default — it dominates the table. Errors are always
# recorded with their payload regardless.
LOG_LLM_PAYLOADS=false
# Must match config/settings.py's default. Pointing this at a different file
# silently creates a second, empty database alongside the real one.
DB_PATH=storage/scrooge.db
TIMEZONE=Asia/Seoul
ANDROID_API_LEVEL=24
SQLITE_VEC_PATH=

# === Remote Access / Security ===
# Interface to bind. Keep 0.0.0.0 on Termux: the Android Tailscale client
# delivers inbound packets on a tun interface, so a 127.0.0.1 bind would make
# the phone unreachable from your laptop. TRUSTED_NETWORKS below is what stops
# that from also exposing the app to whatever WiFi the phone has joined.
API_HOST=0.0.0.0
API_PORT=8000

# Passphrase for the dashboard login. LEAVE EMPTY ONLY FOR LOCAL DEVELOPMENT —
# empty disables the login gate entirely. Set a long random value on the phone.
# Changing it immediately invalidates every existing session, which is how you
# revoke access for someone you previously shared it with.
DASHBOARD_PASSPHRASE=

# How long a login lasts before the passphrase is required again.
DASHBOARD_SESSION_DAYS=30

# Comma-separated CIDRs allowed to connect at all; everything else gets a 403
# before authentication is even considered. The defaults are loopback plus
# Tailscale's IPv4 CGNAT range (100.64.0.0/10) and IPv6 ULA prefix. Add your
# LAN (e.g. 192.168.1.0/24) only if you deliberately want local access too.
# An empty value disables the check and accepts connections from anywhere.
TRUSTED_NETWORKS=127.0.0.0/8,::1/128,100.64.0.0/10,fd7a:115c:a1e0::/48

# Comma-separated CORS origins. Empty means same-origin only, which is correct
# for Termux — FastAPI serves the dashboard and the API from the same port, so
# no cross-origin request is ever legitimate. Only set this to point the Next
# dev server (:3000) at a backend on a different host.
CORS_ORIGINS=
